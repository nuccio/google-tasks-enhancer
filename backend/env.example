# Copy this file to backend/.env and fill in your own values.
# Never commit the .env file.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
# Read-only dev data viewer at /dev (true/1/yes to enable).
# WARNING: keep it false on any machine reachable by others, including through a proxy or tunnel.
DEV_UI_ENABLED=false
