{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(gh api user *)",
      "Bash(gh api 'repos/{owner}/{repo}' *)",
      "Bash(gh api 'repos/{owner}/{repo}/issues/*/events'*)",
      "Bash(gh api --paginate 'repos/{owner}/{repo}/issues/*/sub_issues'*)",
      "Bash(gh api 'repos/{owner}/{repo}/rulesets'*)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git fetch *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git merge *)",
      "Bash(git push origin issue/*)",
      "Bash(gh issue create *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue close *)",
      "Bash(gh pr create *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr review *)",
      "Bash(gh pr merge *)",
      "Bash(python3 -m pytest backend/tests *)",
      "Bash(npm ci)",
      "Bash(npm test)",
      "Bash(npm run build)",
      "Bash(npm run lint)"
    ],
    "deny": [
      "Bash(gh pr merge *--admin*)",
      "Bash(gh * --admin*)",
      "Bash(git push * main)",
      "Bash(git push * main:*)",
      "Bash(git push * HEAD:main)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(gh workflow run *)",
      "Bash(gh repo edit *)",
      "Bash(gh secret *)",
      "Bash(gh auth token*)",
      "Read(~/.config/claudio4nuccio/**)",
      "Read(**/token.json)",
      "Read(**/client_secrets.json)",
      "Read(**/client_secret*.json)",
      "Read(**/credentials.json)",
      "Read(**/.env)",
      "Read(**/*.db)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * refs/heads/main*)",
      "mcp__claude-in-chrome__*"
    ],
    "ask": [
      "Bash(gh release *)",
      "Bash(gh api -X*)",
      "Bash(gh api * -X*)",
      "Bash(gh api --method*)",
      "Bash(gh api * --method*)",
      "Bash(gh api -f*)",
      "Bash(gh api * -f*)",
      "Bash(gh api -F*)",
      "Bash(gh api * -F*)",
      "Bash(gh api --field*)",
      "Bash(gh api * --field*)",
      "Bash(gh api --raw-field*)",
      "Bash(gh api * --raw-field*)",
      "Bash(gh api --input*)",
      "Bash(gh api * --input*)",
      "Bash(gh api graphql*)",
      "Bash(gh api * graphql*)"
    ]
  }
}
